---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { reader } from "../lib/reader";
const hero = await reader.singletons.hero.read();
---

<PortfolioLayout>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <div class="site-shell">
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="Max Jackson home">
        mxjxn<span>_</span>
      </a>
      <span class="masthead-note">ENGINEERING × CREATIVE PRACTICE</span>
      <nav aria-label="Main navigation">
        <a href="#work">
          Work <span>01</span>
        </a>
        <a href="#about">
          About <span>02</span>
        </a>
        <a href="/resume">Résumé ↗</a>
        <a class="nav-contact" href="mailto:mjackson84@gmail.com">
          Let’s talk ↗
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="intro-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="square"></span> MAX JACKSON / BOSTON, MA
          </p>
          <h1 id="intro-title">
            Max
            <br />
            <span class="green">Jackson</span>
          </h1>
          <p class="hero-position">{hero?.tagline}</p>
          <p class="hero-description">{hero?.bio}</p>
          <div class="hero-actions">
            <a class="button" href="#work">
              See my work <span>↓</span>
            </a>
            <a class="text-link" href="/resume">
              Read my résumé ↗
            </a>
          </div>
          <p class="availability">
            <span class="status-light"></span>
            {hero?.status}
          </p>
        </div>
        <figure class="hero-art">
          <img
            src="/art/render-48.jpg"
            alt="A luminous faceted center surrounded by twisting reflective red forms against black, a 3D render by Max Jackson."
            width="1920"
            height="1080"
            fetchpriority="high"
          />
          <div class="art-cross cross-top" aria-hidden="true">
            +
          </div>
          <div class="art-cross cross-bottom" aria-hidden="true">
            +
          </div>
          <figcaption>
            <span>FROM MY DAILY 3D PRACTICE</span>
            <span>BLENDER / 2026</span>
          </figcaption>
        </figure>
      </section>
      <div class="capability-strip" aria-label="Areas of practice">
        <span>AGENT SYSTEMS</span>
        <span>FULL-STACK DEVELOPMENT</span>
        <span>HUMAN CONNECTION</span>
        <span>GENERATIVE ART</span>
      </div>
      <section id="work" class="work section" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="eyebrow">01 / SELECTED WORK</p>
          <h2 id="work-title">Selected work</h2>
        </div>
        <article class="featured-project">
          <div class="project-story">
            <p class="eyebrow">
              001 <span class="muted">/ KNOWLEDGE & AGENTS</span>
            </p>
            <h3>logseqd</h3>
            <p class="project-name">
              A shared knowledge system for me and my agent.
            </p>
            <p>
              Logseq’s block-based documents turned out to make a useful brain
              for Hermes. I built logseqd with Hermes so my agent and other
              tools could query the same notes, then added a mobile interface.
              The system supports my own work and Suchbot’s knowledge.
            </p>
            <div class="tags">
              <span>Clojure</span>
              <span>DataScript</span>
              <span>Hermes</span>
              <span>PWA</span>
            </div>
            <div class="project-links">
              <a href="https://github.com/mxjxn/logseqd">Explore logseqd ↗</a>
              <a href="https://github.com/mxjxn/hermes-logseq">
                Integration template ↗
              </a>
            </div>
          </div>
          <div class="system-panel">
            <div class="panel-title">
              <span>01 / SHARED KNOWLEDGE</span>
              <span aria-hidden="true">[ GRAPH ]</span>
            </div>
            <div
              class="system-diagram"
              role="img"
              aria-label="Logseq clients and a web interface connect to Markdown notes and logseqd, giving Hermes a shared knowledge source."
            >
              <div class="diagram-inputs">
                <span>
                  LOGSEQ
                  <br />
                  <small>phone / desktop</small>
                </span>
                <span>
                  WEB INTERFACE
                  <br />
                  <small>capture / review</small>
                </span>
              </div>
              <div class="diagram-lines" aria-hidden="true">
                <span>│</span>
                <span>│</span>
              </div>
              <div class="diagram-core">
                <span class="core-mark" aria-hidden="true">
                  ⌘
                </span>
                <strong>logseqd</strong>
                <span>MARKDOWN → QUERYABLE KNOWLEDGE</span>
              </div>
              <div class="diagram-arrow" aria-hidden="true">
                ↕
              </div>
              <div class="diagram-agent">
                <span class="square"></span> HERMES{" "}
                <small>read / reason / write back</small>
              </div>
            </div>
            <p class="panel-footnote">
              One shared source. More useful context.
            </p>
          </div>
          <details class="project-details">
            <summary>
              <span>How it works</span>
              <span class="detail-hint">
                Decisions, contribution & limitations
              </span>
              <span class="toggle" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="detail-body">
              <div>
                <h4>The decisions</h4>
                <p>
                  A service around existing notes, rather than a separate
                  knowledge silo. A mobile interface for quick capture. Journal
                  upkeep shaped around conversation, because that’s how I
                  naturally work.
                </p>
              </div>
              <div>
                <h4>My contribution</h4>
                <p>
                  I initiated logseqd, set the workflow and interface
                  requirements, and tested the system in daily use. Hermes
                  contributed substantially to implementation.
                </p>
              </div>
              <div>
                <h4>The reality</h4>
                <p>
                  A small, self-hosted system with ongoing maintenance. Logseq
                  syntax, indexing, and mobile caching required iteration. The
                  public template is an untested alpha; it is not a finished
                  enterprise product.
                </p>
              </div>
            </div>
          </details>
        </article>
        <div class="project-pair">
          <article class="compact-project suchbot-project">
            <p class="eyebrow">002 / SUCHBOT</p>
            <img
              class="suchbot-portrait"
              src="/art/suchbot.png"
              width="4200"
              height="4200"
              loading="lazy"
              alt="Suchbot’s purple pixel-art character with orange details on a black background."
            />
            <h3>Suchbot</h3>
            <p>
              The public face of my Hermes experiments. Suchbot publishes daily
              reports and lets people use creative tools directly in the
              Farcaster timeline. I’ve shaped its writing standards, tools, and
              access to public and private knowledge.
            </p>
            <div class="project-links">
              <a href="https://farcaster.xyz/suchbot">Suchbot on Farcaster ↗</a>
              <a href="https://bot.mxjxn.com/">Read the blog ↗</a>
            </div>
          </article>
          <article class="compact-project">
            <p class="eyebrow">003 / GLITCH PIPELINE</p>
            <h3>Glitch Pipeline</h3>
            <p>
              Make and transform images through commands you can chain together,
              right in the Farcaster timeline:
            </p>
            <pre class="pipeline-example"><code>@suchbot &gt;&gt; generate a flying cat | kaleidoscope::3 | pixel-sort::5</code></pre>
            <div class="project-links">
              <a href="/glitch">Open Glitch Pipeline ↗</a>
            </div>
          </article>
          <article class="compact-project snap-project">
            <p class="eyebrow">004 / SUCH SNAP</p>
            <h3>Such Snap</h3>
            <p>
              A Farcaster snap server with templates for guides, multi-page
              tutorials, polls, quizzes, and token interactions. Interactive
              snaps store responses per user in SQLite, preserving votes and
              answers when people return and showing live results. Such Snap won
              a hackathon award leading up to FarCon Rome.
            </p>
            <div class="project-links">
              <a href="https://snap.mxjxn.com/">Explore Such Snap ↗</a>
            </div>
          </article>
        </div>
        <div class="more-work">
          <span class="eyebrow">ALSO IN THE WORKSHOP</span>
          <a href="https://cryptoart.social/">Cryptoart.social ↗</a>
          <a href="https://such.gallery/">such.gallery ↗</a>
          <a href="https://rogue.boston/">Rogue Pedicab ↗</a>
          <a href="https://github.com/mxjxn">GitHub ↗</a>
        </div>
      </section>
      <section id="about" class="about section" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow">02 / THE PERSON</p>
          <h2 id="about-title">A little about me</h2>
        </div>
        <div class="about-copy">
          <p>
            I’m a developer and artist based in Boston. I currently work as a
            bicycle mechanic and spend much of my time outside work building
            software and making art. I’ve also taught swimming, driven a
            pedicab, and worked on engineering teams at The Boston Globe and
            Charged Particles.
          </p>
          <p>
            Working with people has been a constant through all of it. I’m
            comfortable starting conversations, teaching, and helping when
            someone is frustrated.
          </p>
          <details class="human-story">
            <summary>
              A lesson from the pool <span aria-hidden="true">+</span>
            </summary>
            <p>
              An adult swimmer I met was working hard but afraid of the deep
              end. I noticed how much tension he carried and helped him practice
              moving with less effort. We worked together in short sessions
              alongside his own practice. About six months later, he was
              swimming with the masters program and covering at least a
              kilometer a day.
            </p>
          </details>
          <a class="text-link" href="/resume">
            Experience & background ↗
          </a>
        </div>
      </section>
      <section class="practice section" aria-labelledby="practice-title">
        <figure>
          <img
            src="/art/render-16.jpg"
            alt="An asymmetric cluster of reflective bead-like forms lit in blue and red, surrounded by purple texture, rendered by Max Jackson."
            width="1080"
            height="1080"
            loading="lazy"
          />
          <figcaption>DAILY 3D PRACTICE / BLENDER</figcaption>
        </figure>
        <div class="practice-copy">
          <p class="eyebrow">03 / CREATIVE PRACTICE</p>
          <h2 id="practice-title">Art &amp; daily practice</h2>
          <p>
            I make mandalas, abstract calligraphy, and generative art. Recently
            I started making a 3D render every day. The work here is part of
            that practice.
          </p>
          <a class="text-link" href="https://mxjxn.art/">
            Visit the art portfolio ↗
          </a>
        </div>
      </section>
      <section class="contact section" aria-labelledby="contact-title">
        <p class="eyebrow">04 / START A CONVERSATION</p>
        <h2 id="contact-title">
          Get in <span class="green">touch</span>
        </h2>
        <div>
          <p>
            I’m looking for a developer role where I can work directly with
            people to build useful software and agent systems. If that sounds
            like your team, I’d like to talk.
          </p>
          <a
            class="button"
            href={hero?.cta_url || "mailto:mjackson84@gmail.com"}
          >
            {hero?.cta || "Email me"} <span>↗</span>
          </a>
        </div>
      </section>
    </main>
    <footer>
      <a class="wordmark" href="#main">
        mxjxn<span>_</span>
      </a>
      <div>
        <a href="/blog">Writing</a>
        <a href="https://github.com/mxjxn">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/max-jackson-002742291">
          LinkedIn ↗
        </a>
      </div>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </div>
</PortfolioLayout>
