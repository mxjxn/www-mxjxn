---
import AgentGraph from "../components/AgentGraph.astro";
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { reader } from "../lib/reader";
import { getRecentPublicNotes, publicNoteUrl } from "../lib/publicNotes";
import { getEntry } from "astro:content";
const [hero, cryptoart, suchbot, tools, person, practice, contact, framing, writing] = await Promise.all([
  reader.singletons.hero.readOrThrow(),
  reader.singletons.cryptoart.readOrThrow(),
  reader.singletons.suchbot.readOrThrow(),
  reader.singletons.tools.readOrThrow(),
  reader.singletons.person.readOrThrow(),
  reader.singletons.practice.readOrThrow(),
  reader.singletons.contact.readOrThrow(),
  reader.singletons.framing.readOrThrow(),
  reader.singletons.writing.readOrThrow(),
]);
const featuredPost = writing?.slug
  ? await getEntry("posts", writing.slug).catch(() => null)
  : null;
const recentNotes = writing?.showRecent === false ? [] : await getRecentPublicNotes(4);
---

<PortfolioLayout>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <div class="site-shell">
    <header class="masthead">
      <a class="wordmark" href="/" aria-label="Max Jackson home">
        mxjxn<span>_</span>
      </a>
      <span class="masthead-note">ENGINEERING × CREATIVE PRACTICE</span>
      <nav aria-label="Main navigation">
        <a href="#work">
          Work <span>01</span>
        </a>
        <a href="#about">
          About <span>02</span>
        </a>
        <a href="/resume">Résumé ↗</a>
        <a class="nav-contact" href="mailto:mjackson84@gmail.com">
          Let’s talk ↗
        </a>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <section class="hero" aria-labelledby="intro-title">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="square"></span> MAX JACKSON / BOSTON, MA
          </p>
          <h1 id="intro-title">
            Max
            <br />
            <span class="green">Jackson</span>
          </h1>
          <p class="hero-position">{hero?.tagline}</p>
          <p class="hero-description">{hero?.bio}</p>
          <div class="hero-actions">
            <a class="button" href="#work">
              See my work <span>↓</span>
            </a>
            <a class="text-link" href="/resume">
              Read my résumé ↗
            </a>
          </div>
          <p class="availability">
            <span class="status-light"></span>
            {hero?.status}
          </p>
        </div>
        <figure class="hero-art">
          <img
            src="/art/render-48.jpg"
            alt="A luminous faceted center surrounded by twisting reflective red forms against black, a 3D render by Max Jackson."
            width="1920"
            height="1080"
            fetchpriority="high"
          />
          <div class="art-cross cross-top" aria-hidden="true">
            +
          </div>
          <div class="art-cross cross-bottom" aria-hidden="true">
            +
          </div>
          <figcaption>
            <span>FROM MY DAILY 3D PRACTICE</span>
            <span>BLENDER / 2026</span>
          </figcaption>
        </figure>
      </section>
      <div class="capability-strip" aria-label="Areas of practice">
        <span>{framing.capability1}</span>
        <span>{framing.capability2}</span>
        <span>{framing.capability3}</span>
      </div>
      <div class="experience-context">
        <p>{framing.experience}</p>
        <a class="text-link" href="/resume">Experience & résumé ↗</a>
      </div>
      <section id="work" class="work section" aria-labelledby="work-title">
        <div class="section-heading">
          <p class="eyebrow section-marker">01 / THE WORK</p>
          <h2 id="work-title">{framing.workTitle}</h2>
          <p class="section-deck">{framing.workDescription}</p>
        </div>
        <article class="featured-project auction-project" id="cryptoart">
          <div class="project-story">
            <p class="eyebrow"><span class="project-number">001</span> <span class="muted">/ PRODUCT & INTEGRATION</span></p>
            <h3>{cryptoart.title}</h3>
            <p class="project-name">{cryptoart.subtitle}</p>
            <p>{cryptoart.motivation}</p>
            <p>{cryptoart.implementation}</p>
            <p>{cryptoart.ownership}</p>
            <p>{cryptoart.tooling}</p>
            <div class="tags"><span>Solidity</span><span>On-chain indexing</span><span>React</span><span>Farcaster</span></div>
            <div class="project-links">
              <a class="primary-project-link" href={cryptoart.links.link0.url}>{cryptoart.links.link0.label} ↗</a>
              <a href={cryptoart.links.link1.url}>{cryptoart.links.link1.label} ↗</a>
              <a href={cryptoart.links.link2.url}>{cryptoart.links.link2.label} ↗</a>
            </div>
          </div>
          <aside class="project-evidence" aria-label="Cryptoart.social recognition and integration">
            <p class="eyebrow">RECOGNITION</p>
            <p class="recognition-copy">{cryptoart.grant}</p>
            <p class="rome-support">{cryptoart.sponsorship}</p>
            <div class="integration-path" aria-label="Auction integration flow">
              <span>Auction contracts</span><span aria-hidden="true">↓</span><span>Indexed auction events</span><span aria-hidden="true">↓</span><span>Artist & bidder notifications</span>
            </div>
          </aside>
        </article>
        <section class="suchbot-family" aria-labelledby="suchbot-title">
        <article class="featured-project suchbot-parent">
          <div class="project-story">
            <p class="eyebrow">
              <span class="project-number">002</span> <span class="muted">/ THE AGENT STACK</span>
            </p>
            <h3 id="suchbot-title">{suchbot.title}</h3>
            <p class="project-name">{suchbot.subtitle}</p>
            <p>{suchbot.overview}</p>
            <div class="subsystem-grid">
              {suchbot.subsystems.map((s) => (
                <div class="subsystem">
                  <h4>{s.title}</h4>
                  <p>{s.text}</p>
                </div>
              ))}
            </div>
            <div class="tags">
              <span>Clojure</span>
              <span>DataScript</span>
              <span>Hermes</span>
              <span>PWA</span>
            </div>
            <div class="project-links">
              <a class="primary-project-link" href={suchbot.links.link0.url}>{suchbot.links.link0.label} ↗</a>
              <a href={suchbot.links.link1.url}>{suchbot.links.link1.label} ↗</a>
              <a href={suchbot.links.link2.url}>{suchbot.links.link2.label} ↗</a>
              <a href={suchbot.links.link3.url}>{suchbot.links.link3.label} ↗</a>
            </div>
          </div>
          <AgentGraph />
          <details class="project-details">
            <summary>
              <span>How it works</span>
              <span class="detail-hint">
                Decisions, contribution & limitations
              </span>
              <span class="toggle" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="detail-body">
              <div>
                <h4>{suchbot.decisionsTitle}</h4>
                <p>{suchbot.decisions}</p>
              </div>
              <div>
                <h4>{suchbot.limitationsTitle}</h4>
                <p>{suchbot.limitations}</p>
              </div>
            </div>
          </details>
        </article>
        <div class="suchbot-offshoots">
          <header class="offshoot-heading">
            <p class="eyebrow">{tools.familyLabel}</p>
            <p>{tools.familyDescription}</p>
          </header>
        <div class="stack-ledger">
          {tools.entries.map((e) => (
            <div class={`ledger-row${e.footnote ? ' footnote' : ''}`}>
              <span class="ledger-domain">{e.domain}</span>
              <div class="ledger-body">
                <p>{e.description}</p>
                {e.example && (
                  <pre class="ledger-example"><code>{e.example}</code></pre>
                )}
              </div>
              <a class="ledger-link" href={e.url}>open ↗</a>
            </div>
          ))}
        </div>
        </div>
        </section>
        <div class="more-work">
          <span class="eyebrow">ALSO IN THE WORKSHOP</span>
          <a href={tools.links.link5.url}>{tools.links.link5.label} ↗</a>
          <a href={tools.links.link6.url}>{tools.links.link6.label} ↗</a>
          <a href={tools.links.link7.url}>{tools.links.link7.label} ↗</a>
          <a href={tools.links.link2.url}>{tools.links.link2.label} ↗</a>
          <a href={tools.links.link3.url}>{tools.links.link3.label} ↗</a>
          <a href={tools.links.link4.url}>{tools.links.link4.label} ↗</a>
        </div>
      </section>
      {featuredPost && (
        <section class="writing-strip section" aria-labelledby="writing-title">
          <p class="eyebrow section-marker">{writing.label}</p>
          <div class="writing-featured">
            <h2 id="writing-title">{featuredPost.data.title}</h2>
            <p>{featuredPost.data.excerpt}</p>
            <div class="writing-meta">
              <span>{new Date(featuredPost.data.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</span>
              <a class="text-link" href={`/blog/${featuredPost.data.slug}/`}>Read the article ↗</a>
            </div>
          </div>
        </section>
      )}
      {recentNotes.length > 0 && (
        <section class="recent-articles section" aria-labelledby="recent-articles-title">
          <div class="section-heading">
            <p class="eyebrow section-marker">RECENT ARTICLES</p>
            <h2 id="recent-articles-title">From the notes</h2>
          </div>
          <div class="recent-articles-list">
            {recentNotes.map((note) => (
              <a class="recent-article" href={publicNoteUrl(note.title)}>
                <span>{note.title}</span>
                <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      )}
      <section id="about" class="about section" aria-labelledby="about-title">
        <div class="section-heading">
          <p class="eyebrow section-marker">02 / THE PERSON</p>
          <h2 id="about-title">{person.title}</h2>
        </div>
        <div class="about-copy">
          <p>{person.experience}</p>
          <a class="text-link" href={person.links.link0.url}>{person.links.link0.label} ↗</a>
        </div>
      </section>
      <section class="practice section" aria-labelledby="practice-title">
        <figure>
          <img
            src="/art/render-16.jpg"
            alt="An asymmetric cluster of reflective bead-like forms lit in blue and red, surrounded by purple texture, rendered by Max Jackson."
            width="1080"
            height="1080"
            loading="lazy"
          />
          <figcaption>DAILY 3D PRACTICE / BLENDER</figcaption>
        </figure>
        <div class="practice-copy">
          <p class="eyebrow section-marker">03 / CREATIVE PRACTICE</p>
          <h2 id="practice-title">{practice.title}</h2>
          <p>{practice.description}</p>
          <a class="text-link" href={practice.links.link0.url}>{practice.links.link0.label} ↗</a>
        </div>
      </section>
      <section class="contact section" aria-labelledby="contact-title">
        <p class="eyebrow section-marker">04 / START A CONVERSATION</p>
        <h2 id="contact-title">{contact.title}</h2>
        <div>
          <p>{contact.invitation}</p>
          <a
            class="button"
            href={hero?.cta_url || "mailto:mjackson84@gmail.com"}
          >
            {hero?.cta || "Email me"} <span>↗</span>
          </a>
        </div>
      </section>
    </main>
    <footer>
      <a class="wordmark" href="#main">mxjxn<span>_</span></a>
      <div>
        <a href={contact.links.link1.url}>{contact.links.link1.label} ↗</a>
        <a href={contact.links.link2.url}>{contact.links.link2.label} ↗</a>
        <a href={contact.links.link3.url}>{contact.links.link3.label} ↗</a>
      </div>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </div>
</PortfolioLayout>
