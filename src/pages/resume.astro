---
import PortfolioLayout from "../layouts/PortfolioLayout.astro";
import { getEntry } from "astro:content";
import "../styles/resume.css";
const resume = (await getEntry("resume", "index"))?.data;
if (!resume) throw new Error("Resume content is missing");
---

<PortfolioLayout
  title="Max Jackson — Résumé"
  description="Full-stack engineer working across agent systems, integrations, and self-hosted infrastructure. Experience and selected projects by Max Jackson."
>
  <a class="skip-link" href="#resume-main">
    Skip to résumé
  </a>
  <div class="site-shell resume-shell">
    <header class="masthead resume-nav">
      <a class="wordmark" href="/" aria-label="Max Jackson home">
        mxjxn<span>_</span>
      </a>
      <span class="masthead-note">EXPERIENCE / SELECTED SYSTEMS</span>
      <nav aria-label="Main navigation">
        <a href="/#work">Work</a>
        <a href="/#about">About</a>
        <a href="/resume" aria-current="page">
          Résumé
        </a>
        <a class="nav-contact" href="mailto:mjackson84@gmail.com">
          Let’s talk ↗
        </a>
      </nav>
    </header>
    <main id="resume-main">
      <header class="cv-header">
        <div>
          <p class="eyebrow">RÉSUMÉ / BOSTON, MA</p>
          <h1>
            Max Jackson<span class="green">.</span>
          </h1>
          <p class="cv-headline">{resume.headline}</p>
        </div>
        <div class="cv-actions">
          <button class="button" id="print-resume" type="button">
            Print / Save PDF <span aria-hidden="true">↗</span>
          </button>
          <a class="text-link" href="mailto:mjackson84@gmail.com">
            mjackson84@gmail.com
          </a>
        </div>
      </header>
      <div class="cv-intro">
        <p>{resume.summary}</p>
        <div class="cv-intent">
          <span class="square" aria-hidden="true"></span>
          <p>
            Open to forward deployed
            <br />
            engineering roles
          </p>
        </div>
      </div>
      <div class="cv-grid">
        <aside class="cv-sidebar" aria-label="Skills and contact">
          <section aria-labelledby="skills-title">
            <h2 id="skills-title" class="eyebrow">
              01 / SKILLS
            </h2>
            {resume.skills.map((group) => (
              <div class="cv-skill">
                <h3>{group.category}</h3>
                <p>{group.items.join(" · ")}</p>
              </div>
            ))}
          </section>
          <section class="cv-contact" aria-labelledby="links-title">
            <h2 id="links-title" class="eyebrow">
              FIND ME
            </h2>
            <a href="https://github.com/mxjxn">github.com/mxjxn ↗</a>
            <a href="https://www.linkedin.com/in/max-jackson-002742291">
              LinkedIn ↗
            </a>
            <a href="/">mxjxn.com ↗</a>
          </section>
        </aside>
        <div class="cv-content">
          <section class="cv-section" aria-labelledby="systems-title">
            <div class="cv-section-title">
              <p class="eyebrow">02 / SELECTED SYSTEMS</p>
              <h2 id="systems-title">Hands-on work.</h2>
            </div>
            {resume.projects.map((project) => (
              <article class="cv-project">
                <div class="cv-entry-top">
                  <h3>
                    {project.url ? (
                      <a href={project.url}>
                        {project.name} <span aria-hidden="true">↗</span>
                      </a>
                    ) : (
                      project.name
                    )}
                  </h3>
                  <span class="cv-period">{project.period}</span>
                </div>
                <p>{project.description}</p>
                <p class="cv-tech">{project.tech.join(" / ")}</p>
              </article>
            ))}
          </section>
          <section class="cv-section" aria-labelledby="experience-title">
            <div class="cv-section-title">
              <p class="eyebrow">03 / ENGINEERING EXPERIENCE</p>
              <h2 id="experience-title">Experience</h2>
            </div>
            {resume.experience.map((job) => (
              <article class="cv-job">
                <div class="cv-entry-top">
                  <h3>{job.company}</h3>
                  <span class="cv-period">{job.period}</span>
                </div>
                <p class="cv-role">{job.role}</p>
                <ul>
                  {job.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </article>
            ))}
          </section>
          <section class="cv-section" aria-labelledby="people-title">
            <div class="cv-section-title">
              <p class="eyebrow">04 / WORKING WITH PEOPLE</p>
              <h2 id="people-title">Teaching &amp; customer work</h2>
            </div>
            <p class="cv-context">
              I currently work full time as a bicycle mechanic while building
              software and making art outside work. I’m often the person who
              steps in with frustrated customers. Previously, I taught swimming
              and drove a pedicab—work that taught me to adapt to different
              people, build confidence, and handle rejection without taking it
              personally.
            </p>
          </section>
          <section
            class="cv-section cv-education"
            aria-labelledby="education-title"
          >
            <h2 id="education-title" class="eyebrow">
              05 / EDUCATION
            </h2>
            {resume.education.map((edu) => (
              <article>
                <div class="cv-entry-top">
                  <h3>{edu.school}</h3>
                  <span class="cv-period">{edu.period}</span>
                </div>
                <p>{edu.degree}</p>
                {edu.note && <p class="cv-note">{edu.note}</p>}
              </article>
            ))}
          </section>
        </div>
      </div>
    </main>
    <footer class="cv-footer">
      <a href="/">← Back to selected work</a>
      <a href="mailto:mjackson84@gmail.com">Let’s talk ↗</a>
      <span>MAX JACKSON / BOSTON, MA</span>
    </footer>
  </div>
</PortfolioLayout>
<script>
  document
    .getElementById("print-resume")
    ?.addEventListener("click", () => window.print());
</script>
